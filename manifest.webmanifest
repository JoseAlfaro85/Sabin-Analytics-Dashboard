{
  "name": "Sabin Performance Dashboard",
  "short_name": "Sabin Dashboard",
  "description": "Monthly social, web, and stakeholder reporting dashboard for Sabin Communications.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "browser"
  ],
  "background_color": "#f6f4ef",
